# ============================================================
# Keycap Platform — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# NEVER commit .env to git!
# ============================================================

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://keycap:keycap_dev@localhost:5432/keycap?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://:keycap_dev@localhost:6379"

# ─── Auth (Auth.js v5) ───────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="change-me-at-least-32-characters-long-random-string"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# AUTH_URL="http://localhost:3000"  # Optional, auto-detected in dev
ADMIN_EMAILS="your-email@gmail.com"

# ─── S3 Storage (MinIO in dev) ────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="keycap-assets"
S3_ACCESS_KEY="keycap_minio"
S3_SECRET_KEY="keycap_minio_dev"
S3_SIGNED_URL_TTL=300

# ─── LLM (Gemini) ────────────────────────────────────────────
LLM_API_KEY="your-gemini-api-key"
LLM_MODEL="gemini-2.5-flash"
AI_FREE_DAILY=5
AI_MAX_TOKENS=4096

# ─── CAD Service ──────────────────────────────────────────────
CAD_SERVICE_URL="http://localhost:8100"
CAD_SHARED_SECRET="dev_cad_secret"

# ─── Payment (Xendit / Midtrans) ─────────────────────────────
PAYMENT_PROVIDER="xendit"
PAYMENT_API_KEY="xnd_development_your_key_here"
PAYMENT_WEBHOOK_TOKEN="your_webhook_verification_token"
QRIS_EXPIRY_MIN=30

# ─── Shipping ────────────────────────────────────────────────
SHIPPING_PROVIDER="biteship"
SHIPPING_API_KEY=""
ORIGIN_AREA_ID=""

# ─── Email ────────────────────────────────────────────────────
RESEND_API_KEY=""

# ─── Observability ────────────────────────────────────────────
# SENTRY_DSN=""
LOG_LEVEL="debug"

# ─── Capacity ────────────────────────────────────────────────
MAX_QUEUE_DAYS=7
FAILURE_RATE_DEFAULT=0.15

# ─── Node ─────────────────────────────────────────────────────
NODE_ENV="development"
